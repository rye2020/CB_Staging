/*-------Multi-Level indented Dropdown------------*/

/* Base menu styles */
ul.menu {
    list-style: none;
    padding: 0;
    margin: 0;
}

ul.menu > li {
    position: relative;
    display: inline-block;
}

ul.menu > li > a {
    display: block;
    padding: 10px 15px;
    color: white;
    text-decoration: none;
}

ul.menu > li > a:hover {
    background: #444;
	display: block;
}

/* Submenu styles (applies to all levels) */
ul.sub-menu {
    list-style: none;
    padding: 0;
    margin: 0;
    position: absolute;
    top: 0;
    left: 100%; /* Default for deeper levels */
    display: none; /* Hidden by default */
    background: #444;
   /* min-width: 180px; */
}

/* First-level submenu should appear below parent */
ul.menu > li > ul.sub-menu {
  	top: 100%; 
    left: 0;
	display:none;
}

/* Indent submenu items */
ul.sub-menu li a {
    display: block;
    padding: 10px 15px;
    padding-left: 30px; /* Indent */
    color: white;
    text-decoration: none;
}

ul.sub-menu li a:hover {
    background: #555;
}

/* Show submenu on hover */
ul.menu li:hover > ul.sub-menu,
ul.sub-menu li:hover > ul.sub-menu {
    display: block;
	z-index: 99999;
}

/* Position deeper submenus to the right */
ul.sub-menu li {
    position: relative;
}

ul.sub-menu li ul.sub-menu {
    top: 0;
    left: 100%;
}

